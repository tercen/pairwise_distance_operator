{
  "name": "Pairwise Distance",
  "description": "Computes various pairwise distance metrics between variables.",
  "tags": [
    "descriptive statistics"
  ],
  "authors": [
    "tercen"
  ],
  "urls": [
    "https://github.com/tercen/pairwise_distance_operator"
  ],
  "properties": [
    {
      "kind": "EnumeratedProperty",
      "name": "method",
      "defaultValue": "Euclidean",
      "values": [
        "Euclidean",
        "Pearson",
        "correlation",
        "cosine",
        "Jaccard",
        "Mahalanobis",
        "Manhattan",
        "Bray",
        "Minkowski"
      ],
      "description": "The distance measure to be used."
    },
    {
      "kind": "EnumeratedProperty",
      "name": "missing_data_behaviour",
      "defaultValue": "na.or.complete",
      "values": [
        "na.or.complete",
        "pairwise.complete.obs",
        "everything",
        "all.obs",
        "complete.obs"
      ],
      "description": "Method for computing covariances in the presence of missing values. See cor() function documentation in R."
    }
  ],
  "operatorSpec": {
    "kind": "OperatorSpec",
    "ontologyUri": "https://tercen.com/_ontology/tercen",
    "ontologyVersion": "0.0.1",
    "inputSpecs": [
      {
        "kind": "CrosstabSpec",
        "metaFactors": [
          {
            "kind": "MetaFactor",
            "name": "Variables",
            "type": "",
            "description": "Input variables used to compute the distance",
            "ontologyMapping": "variable",
            "crosstabMapping": "row",
            "cardinality": "1..n",
            "factors": []
          },
          {
            "kind": "MetaFactor",
            "name": "Observations",
            "type": "",
            "description": "Observations",
            "ontologyMapping": "observation",
            "crosstabMapping": "column",
            "cardinality": "1..n",
            "factors": []
          }
        ],
        "axis": [
          {
            "kind": "AxisSpec",
            "metaFactors": [
              {
                "kind": "MetaFactor",
                "name": "Measurements",
                "type": "double",
                "description": "Measurement values",
                "ontologyMapping": "measurement",
                "crosstabMapping": "y",
                "cardinality": "1",
                "factors": []
              }
            ]
          }
        ]
      }
    ],
    "outputSpecsV2": [
      {
        "kind": "OperatorJoinSpec",
        "joinOperators": [
          {
            "kind": "JoinOperator",
            "joinType": "left",
            "leftPair": {
              "kind": "ColumnPair",
              "lColumns": [
                "Variables"
              ],
              "rColumns": [
                "Variables"
              ]
            },
            "rightRelation": {
              "kind": "TableRelation",
              "attributes": [
                {
                  "kind": "Attribute",
                  "name": "dist_to",
                  "type": "string"
                },
                {
                  "kind": "Attribute",
                  "name": "dist",
                  "type": "double"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}